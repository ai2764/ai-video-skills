{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-video-skills/director-storyboard",
  "title": "Director storyboard",
  "type": "object",
  "required": ["global_prompt", "segments"],
  "additionalProperties": true,
  "properties": {
    "global_prompt": { "type": "string", "minLength": 1 },
    "negative_prompt": {
      "type": "string",
      "description": "Only some backends accept this. LTX i2v/flf do; the LTX Director timeline node and MiniMax H3 have no negative input at all and silently ignore it. Where it is ignored, phrase constraints positively in the prompts instead."
    },
    "width": { "type": "integer", "minimum": 64, "maximum": 4096 },
    "height": { "type": "integer", "minimum": 64, "maximum": 4096 },
    "seed": { "type": ["integer", "null"] },
    "fps": { "type": "integer", "minimum": 1, "maximum": 60 },
    "ic_lora_name": { "type": "string" },
    "ic_lora_strength": { "type": "number", "minimum": 0, "maximum": 2 },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "image": { "type": "string" },
          "image_path": { "type": "string" },
          "prompt": { "type": "string" },
          "local_prompt": { "type": "string" },
          "start": { "type": "number", "minimum": 0 },
          "duration": { "type": "number", "minimum": 0.25 },
          "length_seconds": { "type": "number", "minimum": 0.25 },
          "strength": { "type": "number", "minimum": 0, "maximum": 10 },
          "type": { "type": "string", "enum": ["image", "text", "video"] }
        }
      }
    }
  }
}
